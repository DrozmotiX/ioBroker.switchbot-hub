// Specialized tsconfig for type-checking js files
{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// @tsconfig/node22 limits "types" to node only; the test files need the mocha globals
		"types": [
			"node",
			"mocha"
		]
	},
	"include": [
		"**/*.js",
		"**/*.d.ts"
	],
	"exclude": [
		"**/build",
		"node_modules/",
		"widgets/",
		"gulpfile.js"
	]
}
